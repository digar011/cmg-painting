# Copy to .env.local for local development. Never commit real values.
# Production values live in the Vercel dashboard (Project > Settings > Environment Variables).

# Canonical site URL used in metadata, JSON-LD, sitemap and robots.
# Defaults to https://cmgpaintinganddesign.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (optional). Get these from https://www.sanity.io/manage
# Only used in production builds; when unset (or Sanity returns no documents)
# the gallery shows the real projects in lib/projects.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Contact form email (Nodemailer SMTP). Optional locally.
# If SMTP_HOST, SMTP_USER or SMTP_PASS is missing, /api/contact returns 503
# and asks the visitor to call instead of pretending the request was sent.
SMTP_HOST=smtp.your-provider.com
# Defaults to 465 (implicit TLS). Any other port (e.g. 587) uses STARTTLS.
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
# Sender address; defaults to SMTP_USER.
SMTP_FROM=your_email@example.com
# Where quote requests are delivered; defaults to the business email in lib/constants.ts.
CONTACT_EMAIL=CMGpaintinganddesign@hotmail.com
